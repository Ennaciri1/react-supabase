# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`.
# NEVER put the service_role key here — frontend code only uses the anon key.

# Supabase project URL — visible in Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (public) key — safe to expose in the browser bundle
VITE_SUPABASE_ANON_KEY=your-anon-public-key
